class Main {
    function void main() {
        var ShapeGame game;
        var int selection;

        // Clear the screen and show the opening menu in a fixed centered place.
        do Main.drawOpeningMenu();
        do Output.moveCursor(20, 22);
        let selection = Keyboard.readInt("Enter 1 or 2: ");
        
        while ((selection < 1) | (selection > 2)) {
            do Main.drawOpeningMenu();
            do Output.moveCursor(18, 14);
            do Output.printString("Invalid choice. Please enter 1 or 2.");
            do Output.moveCursor(20, 22);
            let selection = Keyboard.readInt("Enter 1 or 2: ");
        }

        do Screen.clearScreen();
        
        // Create and run the game according to the selected shape.
        let game = ShapeGame.new(selection);
        do game.run();
        do game.dispose();

        return;
    }

    function void drawOpeningMenu() {
        do Screen.clearScreen();
        do Output.moveCursor(2, 15);
        do Output.printString("Choose the shape for the game");
        do Output.moveCursor(4, 12);
        do Output.printString("Press 1 for Rectangle or 2 for Triangle");

        do Screen.setColor(true);

        // Left preview: rectangle, centered in the left half of the screen.
        do Screen.drawRectangle(105, 110, 175, 180);
        do Output.moveCursor(18, 12);
        do Output.printString("1 - Rectangle");

        // Right preview: triangle, centered in the right half of the screen.
        do Screen.drawLine(337, 180, 407, 180);
        do Screen.drawLine(337, 180, 372, 110);
        do Screen.drawLine(407, 180, 372, 110);
        do Output.moveCursor(18, 40);
        do Output.printString("2 - Triangle");

        return;
    }
}
